# ── Optimizely Graph (server-side delivery API) ──────────────────────────────
# Base URL of the Optimizely Content Graph API
OPTIMIZELY_API_URL="https://cg.optimizely.com/content/v2"
# Single key for published-content queries (CMS > Settings > API Keys)
OPTIMIZELY_SINGLE_KEY=""
# Base64(AppKey:AppSecret) — required only for draft/preview content queries
OPTIMIZELY_PREVIEW_SECRET=""
# Shared secret for the cache-revalidation webhook endpoint
OPTIMIZELY_REVALIDATE_SECRET=""

# ── Site content ─────────────────────────────────────────────────────────────
# CMS content link/GUID of the GlobalConfigDefault root (global settings)
OPTIMIZELY_GLOBAL_CONFIG_ID=""
# CMS URL of the start page
OPTIMIZELY_START_PAGE_URL="/"

# ── Public (safe to expose to the browser) ───────────────────────────────────
# SaaS CMS instance URL — used for preview/OPE communication script
NEXT_PUBLIC_CMS_URL=""
