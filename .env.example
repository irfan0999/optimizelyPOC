# ── Optimizely Graph (the delivery API this app renders from) ────────────────
# GraphQL endpoint of Optimizely Graph
OPTIMIZELY_API_URL="https://cg.optimizely.com/content/v2"
# Single key for published content — CMS > Settings > API Keys (required)
OPTIMIZELY_SINGLE_KEY=""
# Base64(AppKey:AppSecret) — required only for draft/preview content queries
OPTIMIZELY_PREVIEW_SECRET=""
# Seconds a Graph response stays warm in Next.js' data cache (default 300)
OPTIMIZELY_REVALIDATE="300"
# Set to 1 to skip live requests entirely and render from .cms-cache/ only
OPTIMIZELY_OFFLINE=""

# ── Site content ─────────────────────────────────────────────────────────────
# Content key (GUID) of the global settings item rendered in the header/footer
OPTIMIZELY_GLOBAL_CONFIG_ID=""
# Optional locale for the global settings query, e.g. en
OPTIMIZELY_DEFAULT_LOCALE=""

# ── Browser bridge (development tool, see /cms-bridge) ───────────────────────
# Expose the bridge page/API when NODE_ENV=production (never do this on a public site)
OPTIMIZELY_ENABLE_CMS_BRIDGE=""

# ── Public (safe to expose to the browser) ───────────────────────────────────
# SaaS CMS instance URL — used for preview/OPE communication script
NEXT_PUBLIC_CMS_URL=""
